# =============================================================================
# MedAI Backend — Environment Variables Template
# =============================================================================

NODE_ENV=development
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/med_db
DB_POOL_MAX=10

# AI Provider Configuration (Google Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Cloud Storage Configuration (Cloudinary)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=your_cloudinary_url_here

# Google Places API Key (Optional Provider Enrichment)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://medai.yourdomain.com

# Optional AI Model Name Overrides
EXTRACT_MODEL_NAME=
EMBED_MODEL_NAME=
REASON_MODEL_NAME=
