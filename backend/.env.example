# Server Configuration
PORT=5000
JWT_SECRET=supersecretmedicalkeychangeinproduction

# Database Configuration (Neon PostgreSQL / Local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/med_db

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Configuration
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=your_cloudinary_url_here

# AI Model Configuration (Optional Overrides)
# If using AI_PROVIDER=openai, you can override with models like 'gpt-4o-mini', 'text-embedding-3-large', etc.
# If using AI_PROVIDER=gemini, you can override with models like 'gemini-2.0-flash-lite', 'gemini-embedding-001', etc.
EXTRACT_MODEL_NAME=
EMBED_MODEL_NAME=
REASON_MODEL_NAME=
